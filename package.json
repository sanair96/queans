{
  "name": "queans",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @queans/db db:generate",
    "db:migrate": "pnpm --filter @queans/db db:migrate",
    "dev": "pnpm --parallel --filter @queans/api --filter @queans/web --filter @queans/worker dev",
    "docker:up": "docker compose up -d app-postgres temporal-postgres temporal temporal-ui",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
